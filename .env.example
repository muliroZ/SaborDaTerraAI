GEMINI_API_KEY=
OPENROUTER_API_KEY=

DATA_REF_DATE=2026-10-30

# Prazos do agente em segundos (#49). Vazios = padrões: 12 por chamada de modelo
# (prazo total, sem retentativa no SDK), 20 para o turno inteiro (#37) e 180 de
# quarentena do circuit breaker após falha transitória (0 desliga o circuit breaker).
MODELO_TIMEOUT_S=
TURNO_TIMEOUT_S=
FALLBACK_COOLDOWN_S=

# Turnos (pergunta + resposta) da sessão repassados ao modelo como memória (padrão 6)
MEMORIA_MAX_TURNOS=
GUARDRAIL_MAX_CHARS=

# Cache de respostas estáticas (#36): validade em segundos (padrão 86400 = 24 h; 0 desliga).
# Para esvaziar: uv run python scripts/limpar_cache.py [--expirados]
CACHE_TTL_S=

# Orçamento do agente (padrões: 50 turnos/sessão, 8 chamadas/turno, 32000 tokens/turno)
SESSAO_REQUEST_LIMIT=
TURNO_REQUEST_LIMIT=
TURNO_TOKENS_LIMIT=

# Banco local (docker compose). Vazios = padrões do docker-compose.yml:
# senha "sabor", porta 5432 e URL postgresql://sabor:sabor@localhost:5432/sabor
# DATABASE_URL tem precedência; vazia, a URL é montada com HOST/PORT/USER/PASSWORD/NAME.
# DATABASE_HOST aceita socket Unix (/cloudsql/PROJETO:REGIAO:INSTANCIA no Cloud Run, #17).
DATABASE_URL=
DATABASE_HOST=
DATABASE_PASSWORD=
DATABASE_PORT=
DATABASE_USER=
DATABASE_NAME=

# Porta publicada pelo container da aplicação (docker compose --profile app up, #17; padrão 8501)
APP_PORT=
# Triagem em lote (#14): teto de tokens de cada execução de scripts/triagem_lote.py (padrão 150000).
# Cada pedido também respeita TURNO_TOKENS_LIMIT e TURNO_REQUEST_LIMIT (#32).
TRIAGEM_TOKENS_LIMIT=
